      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "no-as-a-service",
    "naas",
    "fun-api",
    "rejection-api",
    "humor",
    "random",
    "api-client",
    "fetch",
    "typescript",
    "javascript"
  ],
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/NPM-Workbench/no-as-a-service-api-client"
  },
  "homepage": "https://github.com/NPM-Workbench/no-as-a-service-api-client",
  "bugs": {
